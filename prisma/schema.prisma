generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  firstName           String
  lastName            String
  email               String               @unique
  phone               String               @unique
  passwordHash        String
  role                UserRole             @default(CUSTOMER)
  status              UserStatus           @default(PENDING)
  /// SELF_REGISTER | ADMIN_REGISTER
  registrationSource  String               @default("SELF_REGISTER")
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  credentials         ChargingCredential[]
  chargingSessions    ChargingSession?
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]
  refreshTokens       RefreshToken[]
  wallet              Wallet?

  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt hash of the opaque random token
  tokenHash String    @unique
  /// Token family identifier for theft detection
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt hash of the opaque random token
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id            String      @id @default(cuid())
  /// User ID or 'system'
  actorId       String
  /// Denormalized email for readable audit queries without joins
  actorEmail    String?
  /// AuditAction constant value (string for extensibility without migrations)
  action        String
  /// Entity type, e.g. 'user', 'refresh_token'
  resource      String
  resourceId    String?
  result        AuditResult
  correlationId String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

model ChargingCredential {
  id         String           @id @default(cuid())
  userId     String
  type       CredentialType   @default(RFID)
  identifier String           @unique
  status     CredentialStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  expiryDate DateTime?
  lastUsedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([userId])
  @@map("charging_credentials")
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  /// Current balance in kobo (NGN minor units)
  balanceKobo  Int                 @default(0)
  status       WalletStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  payments     Payment[]
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  walletId          String
  amountKobo        Int
  currency          String        @default("NGN")
  provider          String
  providerReference String?       @unique
  reference         String        @unique
  status            PaymentStatus @default(PENDING)
  method            String?
  metadata          Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model PaymentProviderConfig {
  id                String   @id @default(cuid())
  primaryProvider   String
  secondaryProvider String?
  tertiaryProvider  String?
  automaticFailover Boolean  @default(true)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([primaryProvider])
}

model PaymentRefund {
  id                String    @id @default(cuid())
  paymentId         String
  provider          String
  providerReference String
  refundReference   String    @unique
  amountKobo        Int
  reason            String
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([paymentId])
  @@index([provider])
  @@index([status])
}

model WalletTransaction {
  id               String            @id @default(cuid())
  walletId         String
  userId           String
  type             TransactionType
  status           TransactionStatus @default(COMPLETED)
  /// Signed amount in kobo: positive = credit, negative = debit
  amountKobo       Int
  /// Wallet balance in kobo after this transaction was applied
  balanceAfterKobo Int
  /// Unique business reference, e.g. TOP-XXXX or CHG-XXXX
  reference        String            @unique
  description      String
  /// Payment method for top-ups (BANK_TRANSFER | CARD | USSD)
  method           String?
  sessionId        String?
  createdAt        DateTime          @default(now())
  session          ChargingSession?  @relation(fields: [sessionId], references: [id])
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

model Station {
  id                  String            @id @default(cuid())
  name                String
  location            String
  /// Maximum charging power in kW
  powerKw             Float
  connectorType       String
  connectorsTotal     Int
  connectorsAvailable Int
  /// Energy tariff in kobo per kWh
  tariffKoboPerKwh    Int
  status              StationStatus     @default(AVAILABLE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sessions            ChargingSession[]

  @@index([status])
  @@map("stations")
}

model ChargingSession {
  id               String              @id @default(cuid())
  userId           String              @unique(map: "charging_sessions_one_active_per_user", where: raw("(status = 'ACTIVE'::\"SessionStatus\")"))
  stationId        String
  status           SessionStatus       @default(ACTIVE)
  /// Energy delivered in Wh (integer to avoid float drift)
  energyWh         Int                 @default(0)
  /// Final cost in kobo (0 while active; live cost is computed server-side)
  costKobo         Int                 @default(0)
  /// Optional customer spend limit for this session, in kobo
  limitKobo        Int?
  /// Tariff snapshot at session start, kobo per kWh
  tariffKoboPerKwh Int
  /// Power snapshot at session start, kW
  powerKw          Float
  startedAt        DateTime            @default(now())
  endedAt          DateTime?
  /// How the session ended: USER_STOP | LIMIT_REACHED | BALANCE_EXHAUSTED
  stopReason       String?
  station          Station             @relation(fields: [stationId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("charging_sessions")
}

enum CredentialType {
  RFID
  APP
  API_TOKEN
}

enum CredentialStatus {
  ACTIVE
  BLOCKED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  TOPUP
  CHARGE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum StationStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAULTED
}

enum UserRole {
  CUSTOMER
  ADMIN_OFFICER
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  TECHNICAL
  DEVELOPER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// =====================================
// MODULE 5 OCPP PHASE 1
// ChargePoint Registry
// =====================================

enum ChargePointStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED
  FINISHING
  UNAVAILABLE
  FAULTED
}

model ChargePoint {
  id String @id @default(uuid())

  serialNumber String @unique

  vendor String?

  model String?

  firmwareVersion String?

  protocolVersion String @default("OCPP1.6")

  status ChargePointStatus @default(UNAVAILABLE)

  lastHeartbeat DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  connectors      Connector[]
  ocppTransactions OcppTransaction[]
  ocppConnections OcppConnection[]
  heartbeatLogs   HeartbeatLog[]
}


model Connector {
  id String @id @default(uuid())

  chargePointId String

  connectorNumber Int

  status ChargePointStatus @default(AVAILABLE)

  chargePoint ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Cascade)

  ocppTransactions OcppTransaction[]

  @@unique([chargePointId, connectorNumber])
}

model OcppConnection {
  id             String      @id @default(uuid())
  chargePointId  String
  connected      Boolean     @default(false)
  connectedAt    DateTime?
  disconnectedAt DateTime?
  remoteAddress  String?
  lastMessageAt  DateTime?
  chargePoint    ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
}

model HeartbeatLog {
  id            String      @id @default(uuid())
  chargePointId String
  receivedAt    DateTime    @default(now())
  status        String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
}


// =====================================
// MODULE 5 PHASE 3.5
// OCPP Transaction Lifecycle Context
// =====================================

model OcppTransaction {
  id             String   @id @default(cuid())

  transactionId  Int      @unique

  chargePointId  String
  connectorId    String

  idTag          String?

  meterStart     Int      @default(0)
  meterStop      Int?

  lastMeterValueAt DateTime?
  energyWh       Int      @default(0)

  status         String   @default("ACTIVE")

  startedAt      DateTime @default(now())
  stoppedAt      DateTime?

  chargePoint ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Cascade)

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([chargePointId])
  @@index([connectorId])
}
