// Camel Mobility Wallet — Prisma Schema
// Module 1: Enterprise Foundation, Identity & Access Management
//
// This schema covers ONLY Module 1 domain entities.
// Future domains (Wallet, Sessions, NFC, Stations, etc.) are
// added in their respective modules via migrations.
//
// Rules:
// - All migrations are version-controlled under prisma/migrations/
// - Never modify production schema manually
// - Append-only tables (AuditLog) must never be updated or deleted

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User Identity ────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  firstName           String
  lastName            String
  email               String     @unique
  phone               String     @unique
  passwordHash        String
  role                UserRole   @default(CUSTOMER)
  status              UserStatus @default(PENDING)
  /// SELF_REGISTER | ADMIN_REGISTER
  registrationSource  String     @default("SELF_REGISTER")

  // Security tracking
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────────
// Opaque refresh tokens are stored as bcrypt hashes, never plaintext.
// token_family enables detection of refresh token reuse (theft detection):
// if a revoked token in a family is presented, all tokens in that family
// are immediately revoked.

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  /// bcrypt hash of the opaque random token
  tokenHash  String    @unique
  /// Token family identifier for theft detection
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Password Reset Token ─────────────────────────────────────────────────────
// Single-use tokens sent to the user's email for password reset.
// Stored as bcrypt hash, never plaintext.

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt hash of the opaque random token
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
// Append-only security and operational audit trail.
// Records MUST NOT be updated or deleted.
// actorId is a string (not FK) to accommodate 'system' as actor.

model AuditLog {
  id            String      @id @default(cuid())
  /// User ID or 'system'
  actorId       String
  /// Denormalized email for readable audit queries without joins
  actorEmail    String?
  /// AuditAction constant value (string for extensibility without migrations)
  action        String
  /// Entity type, e.g. 'user', 'refresh_token'
  resource      String
  resourceId    String?
  result        AuditResult
  correlationId String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── System Configuration ─────────────────────────────────────────────────────
// Configurable platform settings managed through Super Admin controls.
// Provides a controlled override mechanism for business rule constants.

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ─── Enumerations ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN_OFFICER
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  TECHNICAL
  DEVELOPER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuditResult {
  SUCCESS
  FAILURE
}
