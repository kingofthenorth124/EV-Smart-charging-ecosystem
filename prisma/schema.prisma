// Camel Mobility Wallet — Prisma Schema
// Module 1: Enterprise Foundation, Identity & Access Management
//
// This schema covers ONLY Module 1 domain entities.
// Future domains (Wallet, Sessions, NFC, Stations, etc.) are
// added in their respective modules via migrations.
//
// Rules:
// - All migrations are version-controlled under prisma/migrations/
// - Never modify production schema manually
// - Append-only tables (AuditLog) must never be updated or deleted

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User Identity ────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  firstName          String
  lastName           String
  email              String     @unique
  phone              String     @unique
  passwordHash       String
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(PENDING)
  /// SELF_REGISTER | ADMIN_REGISTER
  registrationSource String     @default("SELF_REGISTER")

  // Security tracking
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  wallet              Wallet?
  payments            Payment[]
  chargingSessions    ChargingSession[]
  credentials         ChargingCredential[]
  fleetMembers        FleetMember[]

  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────────
// Opaque refresh tokens are stored as bcrypt hashes, never plaintext.
// token_family enables detection of refresh token reuse (theft detection):
// if a revoked token in a family is presented, all tokens in that family
// are immediately revoked.

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt hash of the opaque random token
  tokenHash String    @unique
  /// Token family identifier for theft detection
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Password Reset Token ─────────────────────────────────────────────────────
// Single-use tokens sent to the user's email for password reset.
// Stored as bcrypt hash, never plaintext.

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// bcrypt hash of the opaque random token
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
// Append-only security and operational audit trail.
// Records MUST NOT be updated or deleted.
// actorId is a string (not FK) to accommodate 'system' as actor.

model AuditLog {
  id            String      @id @default(cuid())
  /// User ID or 'system'
  actorId       String
  /// Denormalized email for readable audit queries without joins
  actorEmail    String?
  /// AuditAction constant value (string for extensibility without migrations)
  action        String
  /// Entity type, e.g. 'user', 'refresh_token'
  resource      String
  resourceId    String?
  result        AuditResult
  correlationId String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── System Configuration ─────────────────────────────────────────────────────
// Configurable platform settings managed through Super Admin controls.
// Provides a controlled override mechanism for business rule constants.

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ─── Wallet (Module 2) ────────────────────────────────────────────────────────
// One wallet per user. All amounts are stored in kobo (integer minor units).
// The backend is the ONLY authoritative source for balances.

// ─── Charging Credentials (RFID/NFC/App Identity) ───────────────────────────

model ChargingCredential {
  id String @id @default(cuid())

  userId String

  type CredentialType @default(RFID)

  identifier String @unique

  status CredentialStatus @default(ACTIVE)

  expiryDate DateTime?

  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([userId])
  @@map("charging_credentials")
}

model Wallet {
  id          String       @id @default(cuid())
  userId      String       @unique
  /// Current balance in kobo (NGN minor units)
  balanceKobo Int          @default(0)
  status      WalletStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payments     Payment[]

  @@map("wallets")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  walletId          String
  amountKobo        Int
  currency          String        @default("NGN")
  provider          String
  providerReference String?       @unique
  reference         String        @unique
  status            PaymentStatus @default(PENDING)
  method            String?
  metadata          Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model PaymentProviderConfig {
  id                String   @id @default(cuid())
  primaryProvider   String
  secondaryProvider String?
  tertiaryProvider  String?
  automaticFailover Boolean  @default(true)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([primaryProvider])
}

model PaymentRefund {
  id                String    @id @default(cuid())
  paymentId         String
  provider          String
  providerReference String
  refundReference   String    @unique
  amountKobo        Int
  reason            String
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([paymentId])
  @@index([provider])
  @@index([status])
}

model WalletTransaction {
  id               String            @id @default(cuid())
  walletId         String
  userId           String
  type             TransactionType
  status           TransactionStatus @default(COMPLETED)
  /// Signed amount in kobo: positive = credit, negative = debit
  amountKobo       Int
  /// Wallet balance in kobo after this transaction was applied
  balanceAfterKobo Int
  /// Unique business reference, e.g. TOP-XXXX or CHG-XXXX
  reference        String            @unique
  description      String
  /// Payment method for top-ups (BANK_TRANSFER | CARD | USSD)
  method           String?
  sessionId        String?
  createdAt        DateTime          @default(now())

  wallet  Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session ChargingSession? @relation(fields: [sessionId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

// ─── Fleet Management ────────────────────────────────────────────────────────

enum FleetStatus {
  ACTIVE

  SUSPENDED

  CLOSED
}

enum VehicleStatus {
  ACTIVE

  DISABLED

  RETIRED
}

enum FleetMemberRole {
  DRIVER

  ADMIN

  MANAGER
}

// ─── Charging (Module 2) ──────────────────────────────────────────────────────

model Station {
  id                  String        @id @default(cuid())
  name                String
  location            String
  /// Maximum charging power in kW
  powerKw             Float
  connectorType       String
  connectorsTotal     Int
  connectorsAvailable Int
  /// Energy tariff in kobo per kWh
  tariffKoboPerKwh    Int
  status              StationStatus @default(AVAILABLE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions ChargingSession[]

  @@index([status])
  @@map("stations")
}

model ChargingSession {
  id               String        @id @default(cuid())
  userId           String
  stationId        String
  status           SessionStatus @default(ACTIVE)
  /// Energy delivered in Wh (integer to avoid float drift)
  energyWh         Int           @default(0)
  /// Final cost in kobo (0 while active; live cost is computed server-side)
  costKobo         Int           @default(0)
  /// Optional customer spend limit for this session, in kobo
  limitKobo        Int?
  /// Tariff snapshot at session start, kobo per kWh
  tariffKoboPerKwh Int
  /// Power snapshot at session start, kW
  powerKw          Float
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  /// How the session ended: USER_STOP | LIMIT_REACHED | BALANCE_EXHAUSTED
  stopReason       String?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  station      Station             @relation(fields: [stationId], references: [id])
  transactions WalletTransaction[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("charging_sessions")
}

// ─── Enumerations ─────────────────────────────────────────────────────────────

enum CredentialType {
  RFID
  APP
  API_TOKEN
}

enum CredentialStatus {
  ACTIVE
  BLOCKED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  TOPUP
  CHARGE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum StationStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAULTED
}

enum UserRole {
  CUSTOMER
  ADMIN_OFFICER
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  TECHNICAL
  DEVELOPER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// ───────── Fleet Management ─────────

model Fleet {
  id String @id @default(cuid())

  name String

  status FleetStatus @default(ACTIVE)

  wallet FleetWallet?

  members FleetMember[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("fleets")
}

model FleetMember {
  id String @id @default(cuid())

  fleetId String

  userId String

  role FleetMemberRole @default(DRIVER)

  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fleetId, userId])
  @@map("fleet_members")
}

model FleetWallet {
  id String @id @default(cuid())

  fleetId String @unique

  balanceKobo Int @default(0)

  status WalletStatus @default(ACTIVE)

  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("fleet_wallets")
}
