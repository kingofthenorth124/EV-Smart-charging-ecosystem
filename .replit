modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano"]

[userenv]

[userenv.development]
FRONTEND_URL = "https://cee75cbb-579c-4bed-8d64-24f9d99a61b3-00-3kkgoqlypa4be.janeway.replit.dev/web"
ACCEPTANCE_TEST_KEY = "camel-acceptance-bypass-2026"

[userenv.shared]
EMAIL_FROM = "noreply@camel-wallet.app"
